      },
      "formula": "M(e,j,f) = keccak256(abi.encode(F(\"b1.member\"), uint256(e), uint256(j), uint256(f))), j < memberCount",
      "fields": [
        "nodeIDLength",
        "nodeID0",
        "nodeID1",
        "nodeID2",
        "nodeID3",
        "key0",
        "key1",
        "weight"
